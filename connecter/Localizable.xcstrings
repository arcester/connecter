    "Test connection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbindung testen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester la connexion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova connessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続をテスト"
          }
        },
        "pt-BR": {
          "stringUnit": {
