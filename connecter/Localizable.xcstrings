    "\"%@\" was disabled after %lld failed attempts. Turn it on again in Connecter to retry.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ wurde nach %2$#@attempts@ deaktiviert. Aktiviere die Freigabe in Connecter wieder, um es erneut zu versuchen."
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Fehlversuch"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg Fehlversuchen"
                    }
                  }
                }
              }
            }
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\" was disabled after %2$#@attempts@. Turn it on again in Connecter to retry."
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg failed attempt"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg failed attempts"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» se ha desactivado tras %2$#@attempts@. Vuelve a activarlo en Connecter para reintentar."
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg intento fallido"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg intentos fallidos"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » a été désactivé après %2$#@attempts@. Réactivez-le dans Connecter pour réessayer."
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
