                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg tentatives échouées"
                    }
                  }
                }
              }
            }
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è stata disattivata dopo %2$#@attempts@. Riattivala in Connecter per riprovare."
          },
          "substitutions": {
            "attempts": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
