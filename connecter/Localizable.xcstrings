    "macOS is not responding to mount requests": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS reagiert nicht auf Einbindeanfragen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS no responde a las peticiones de montaje"
          }
        },
        "fr": {
          "stringUnit": {
