    "Used by the shares on this server that have “Use the server’s credentials” turned on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden von den Freigaben dieses Servers verwendet, bei denen „Anmeldedaten des Servers verwenden“ aktiviert ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las usan los recursos de este servidor que tienen activado «Usar las credenciales del servidor»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisés par les partages de ce serveur pour lesquels « Utiliser les identifiants du serveur » est activé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usate dalle condivisioni di questo server che hanno attivato «Usa le credenziali del server»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「サーバの資格情報を使用」がオンになっている、このサーバの共有で使用されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usadas pelos compartilhamentos deste servidor que têm “Usar as credenciais do servidor” ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
