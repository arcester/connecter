    "macOS's NetAuth service is not responding. Restart it to recover the mounts.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der NetAuth-Dienst von macOS reagiert nicht. Starte ihn neu, um die Einbindungen wiederherzustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio NetAuth de macOS no responde. Reinícialo para recuperar los montajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service NetAuth de macOS ne répond pas. Redémarrez-le pour récupérer les montages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio NetAuth di macOS non risponde. Riavvialo per ripristinare i montaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS の NetAuth サービスが応答していません。再起動するとマウントを復旧できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço NetAuth do macOS não está respondendo. Reinicie-o para recuperar as montagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 的 NetAuth 服务未响应。重新启动它以恢复装载。"
          }
        }
      }
    },
