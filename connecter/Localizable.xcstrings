          }
        }
      }
    },
    "The App Store version of Connecter is not allowed to restart macOS services. Run this command in Terminal, or quit “NetAuthSysAgent” in Activity Monitor, then choose Retry Now:\n\n%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App Store-Version von Connecter darf keine macOS-Dienste neu starten. Führe diesen Befehl im Terminal aus oder beende „NetAuthSysAgent“ in der Aktivitätsanzeige und wähle dann „Jetzt erneut versuchen“:\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de Connecter de la App Store no puede reiniciar servicios de macOS. Ejecuta este comando en Terminal, o cierra «NetAuthSysAgent» desde Monitor de Actividad, y pulsa Reintentar ahora:\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version App Store de Connecter n’est pas autorisée à redémarrer les services de macOS. Exécutez cette commande dans Terminal ou quittez « NetAuthSysAgent » dans le Moniteur d’activité, puis choisissez Réessayer maintenant :\n\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione App Store di Connecter non può riavviare i servizi di macOS. Esegui questo comando nel Terminale oppure chiudi «NetAuthSysAgent» in Monitoraggio Attività, poi scegli Riprova ora:\n\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 版の Connecter は macOS のサービスを再起動できません。ターミナルでこのコマンドを実行するか、アクティビティモニタで「NetAuthSysAgent」を終了してから「今すぐ再試行」を選択してください：\n\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão da App Store do Connecter não pode reiniciar serviços do macOS. Execute este comando no Terminal ou encerre “NetAuthSysAgent” no Monitor de Atividade e escolha Tentar agora:\n\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store 版本的 Connecter 不能重新启动 macOS 服务。请在“终端”中运行此命令，或在“活动监视器”中退出“NetAuthSysAgent”，然后选择“立即重试”：\n\n%@"
          }
        }
      }
    },
    "The saved password could not be read from the Keychain. Enter it again to replace it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gesicherte Passwort konnte nicht aus dem Schlüsselbund gelesen werden. Gib es erneut ein, um es zu ersetzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido leer la contraseña guardada en el llavero. Escríbela de nuevo para reemplazarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mot de passe enregistré n’a pas pu être lu depuis le trousseau. Saisissez-le à nouveau pour le remplacer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere la password salvata dal portachiavi. Inseriscila di nuovo per sostituirla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されたパスワードをキーチェーンから読み込めませんでした。置き換えるにはもう一度入力してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler a senha salva nas Chaves. Digite-a novamente para substituí-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取已存储的密码。请重新输入以替换。"
          }
        }
      }
    },
    "This action cannot be undone.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion kann nicht widerrufen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は取り消せません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ação não pode ser desfeita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法撤销。"
          }
        }
      }
    },
    "This server has no credentials yet. Set them with “Server Credentials…” in the server’s menu.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server hat noch keine Anmeldedaten. Lege sie im Menü des Servers mit „Server-Anmeldedaten …“ fest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor aún no tiene credenciales. Configúralas con «Credenciales del servidor…» en su menú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur n’a pas encore d’identifiants. Définissez-les avec « Identifiants du serveur… » dans le menu du serveur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non ha ancora credenziali. Impostale con «Credenziali del server…» nel menu del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバにはまだ資格情報がありません。サーバのメニューの「サーバの資格情報…」で設定してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor ainda não tem credenciais. Defina-as com “Credenciais do servidor…” no menu do servidor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器还没有凭证。请在服务器菜单中通过“服务器凭证…”进行设置。"
          }
        }
      }
    },
